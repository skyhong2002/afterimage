---
// Review the candidates found by scripts/discover.py. Decisions stay in this
// browser (localStorage) until exported; see docs/DISCOVER.md.
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>夢境製作所 · afterimage</title>
  </head>
  <body>
    <header>
      <h1><a href="/">afterimage</a> <span>夢境製作所 Dream Productions</span></h1>
      <span id="prog"></span>
      <button id="export" type="button">匯出決定</button>
      <button id="reset" type="button">清除本機決定</button>
    </header>

    <main id="empty" hidden>
      <p>收件匣是空的。</p>
      <p class="dim">用 <code>uv run --group enrich scripts/discover.py</code> 找新的候選。</p>
    </main>

    <main id="stage" hidden>
      <section id="left">
        <img id="cand" alt="" />
      </section>
      <aside id="right">
        <h2 id="work"></h2>
        <p id="reason" class="dim"></p>
        <p id="meta"></p>
        <p><a id="src" target="_blank" rel="noopener">在 Wallhaven 開啟 ↗</a></p>
        <div id="near-wrap" hidden>
          <p id="near-note"></p>
          <img id="near" alt="" />
        </div>
        <div id="state"></div>
        <div class="actions">
          <button id="accept" type="button" class="yes">接受 <kbd>A</kbd></button>
          <button id="reject" type="button" class="no">拒絕 <kbd>R</kbd></button>
          <button id="skip" type="button">跳過 <kbd>S</kbd></button>
          <button id="prev" type="button">上一個 <kbd>←</kbd></button>
        </div>
        <p class="dim" id="hint">A 接受 · R 拒絕 · S 跳過 · ← → 前後移動</p>
      </aside>
    </main>

    <script>
      type Cand = {
        id: string; source_url: string; thumb_url: string; preview_url?: string | null; width: number; height: number; favorites: number;
        work_query: string; reason: string; nearest_id?: string | null; similarity?: number | null;
      };
      const KEY = 'afterimage-discover-v1';
      const $ = (id: string) => document.getElementById(id)!;
      let cands: Cand[] = [];
      let decisions: Record<string, 'accept' | 'reject'> = {};
      try { decisions = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { /* corrupt store */ }
      let i = 0;

      const save = () => localStorage.setItem(KEY, JSON.stringify(decisions));
      const undecided = () => cands.filter((c) => !decisions[c.id]).length;

      function render() {
        $('prog').textContent = `${cands.length - undecided()}/${cands.length} 已決定 · 接受 ${Object.values(decisions).filter((v) => v === 'accept').length}`;
        const c = cands[i];
        $('cand').setAttribute('src', c.preview_url || c.thumb_url);
        $('work').textContent = c.work_query;
        $('reason').textContent = c.reason;
        $('meta').textContent = `${c.width}×${c.height} · ★${c.favorites} · 第 ${i + 1}/${cands.length} 張`;
        $('src').setAttribute('href', c.source_url);
        const near = $('near-wrap');
        near.hidden = !(c.nearest_id && (c.similarity ?? 0) >= 0.8);
        if (!near.hidden) {
          $('near-note').textContent = `和收藏裡這張很像(相似度 ${c.similarity!.toFixed(2)}),確認不是重複:`;
          $('near').setAttribute('src', `/thumbs/${c.nearest_id}.avif`);
        }
        const d = decisions[c.id];
        $('state').textContent = d === 'accept' ? '✓ 已接受' : d === 'reject' ? '✗ 已拒絕' : '';
        $('state').className = d ?? '';
      }

      function decide(v: 'accept' | 'reject') {
        decisions[cands[i].id] = v;
        save();
        const next = cands.findIndex((c, k) => k > i && !decisions[c.id]);
        const any = next >= 0 ? next : cands.findIndex((c) => !decisions[c.id]);
        if (any >= 0) i = any;
        render();
      }
      const move = (d: number) => { i = (i + d + cands.length) % cands.length; render(); };

      function exportDecisions() {
        const text = JSON.stringify({ version: 1, decisions }, null, 1);
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
        a.download = `afterimage-decisions-${new Date().toISOString().slice(0, 16).replace(/[-:T]/g, '')}.json`;
        a.click();
        URL.revokeObjectURL(a.href);
        const b = $('export');
        navigator.clipboard?.writeText(text)?.then(() => { b.textContent = '已下載並複製 ✓'; }, () => { b.textContent = '已下載(複製失敗)'; });
        setTimeout(() => { b.textContent = '匯出決定'; }, 2500);
      }

      $('accept').addEventListener('click', () => decide('accept'));
      $('reject').addEventListener('click', () => decide('reject'));
      $('skip').addEventListener('click', () => move(1));
      $('prev').addEventListener('click', () => move(-1));
      $('export').addEventListener('click', exportDecisions);
      $('reset').addEventListener('click', () => {
        if (confirm('清除這個瀏覽器裡尚未匯出的決定?')) { localStorage.removeItem(KEY); location.reload(); }
      });
      document.addEventListener('keydown', (ev) => {
        if (!cands.length || ev.metaKey || ev.ctrlKey || ev.altKey) return;
        const k = ev.key.toLowerCase();
        if (k === 'a') decide('accept');
        else if (k === 'r') decide('reject');
        else if (k === 's' || k === 'arrowright') move(1);
        else if (k === 'arrowleft') move(-1);
        else return;
        ev.preventDefault();
      });

      fetch('/api/inbox.json').then((r) => r.json()).then((doc: { candidates: Cand[] }) => {
        cands = doc.candidates;
        // forget decisions about candidates that are no longer in the inbox
        const live = new Set(cands.map((c) => c.id));
        for (const id of Object.keys(decisions)) if (!live.has(id)) delete decisions[id];
        save();
        if (!cands.length) { $('empty').hidden = false; return; }
        i = Math.max(0, cands.findIndex((c) => !decisions[c.id]));
        $('stage').hidden = false;
        render();
      }).catch(() => { $('empty').hidden = false; });
    </script>

    <style is:global>
      :root { color-scheme: dark; --bg: #0b0b0e; --fg: #e8e6e3; --dim: #8a8a93; --line: #23232a; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, "Noto Sans TC", sans-serif; }
      [hidden] { display: none !important; }
      header { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--line); }
      h1 { margin: 0; font-size: 18px; font-weight: 600; flex: 1; }
      h1 a { color: inherit; text-decoration: none; }
      h1 span { color: var(--dim); font-weight: 400; margin-left: 8px; font-size: 14px; }
      #prog { color: var(--dim); font-size: 13px; }
      button { font: inherit; font-size: 13px; color: var(--fg); background: #15151a; border: 1px solid var(--line); border-radius: 6px; padding: 7px 12px; cursor: pointer; }
      button:hover { border-color: var(--dim); }
      main { padding: 18px 20px; }
      #stage { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
      #left { display: flex; justify-content: center; background: #000; border-radius: 8px; overflow: hidden; }
      #cand { max-width: 100%; max-height: calc(100vh - 120px); display: block; object-fit: contain; }
      #right h2 { margin: 0; font-size: 20px; }
      #right p { margin: 6px 0; }
      .dim { color: var(--dim); font-size: 13px; }
      a { color: var(--fg); }
      #near { width: 100%; border-radius: 6px; border: 1px solid var(--line); }
      #near-note { color: #f5c518; font-size: 13px; }
      #state { min-height: 1.6em; font-weight: 600; margin: 8px 0; }
      #state.accept { color: #7ee787; }
      #state.reject { color: #ff7b72; }
      .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 12px 0; }
      .actions .yes { background: #1f3a2a; border-color: #2f6b45; padding: 12px; }
      .actions .no { background: #3a1f23; border-color: #6b2f37; padding: 12px; }
      kbd { font: inherit; font-size: 10px; opacity: .7; border: 1px solid #ffffff33; border-radius: 3px; padding: 0 4px; margin-left: 4px; }
      @media (max-width: 800px) { #stage { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
