<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0e" />
    <title>登入 · afterimage</title>
  </head>
  <body>
    <main>
      <h1><a href="/"><img class="mark" src="/favicon.svg" alt="" width="24" height="24" />afterimage</a> <span>殘影</span></h1>
      <form id="form" autocomplete="on">
        <label for="pw">密碼</label>
        <input id="pw" name="password" type="password" autocomplete="current-password" required autofocus />
        <button type="submit">登入</button>
        <p id="msg" role="alert"></p>
      </form>
    </main>

    <script>
      const form = document.getElementById('form') as HTMLFormElement;
      const msg = document.getElementById('msg')!;
      // only ever go back to a path on this site
      const raw = new URLSearchParams(location.search).get('next') ?? '/';
      const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/';

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        msg.textContent = '';
        const r = await fetch('/api/login', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ password: (document.getElementById('pw') as HTMLInputElement).value }),
        });
        if (r.ok) { location.assign(next); return; }
        msg.textContent = r.status === 429 ? '嘗試次數太多,請稍後再試' : '密碼不正確';
      });
    </script>

    <style is:global>
      :root { color-scheme: dark; --bg: #0b0b0e; --fg: #e8e6e3; --dim: #8a8a93; --line: #23232a; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, "Noto Sans TC", sans-serif; display: grid; place-items: center; min-height: 100vh; }
      main { width: min(340px, 90vw); }
      h1 { font-size: 20px; font-weight: 600; margin: 0 0 24px; }
      h1 .mark { width: 1.7em; height: 1.7em; vertical-align: -0.5em; margin: 0 6px 0 -4px; }
      h1 a { color: inherit; text-decoration: none; }
      h1 span { color: var(--dim); font-weight: 400; margin-left: 6px; }
      label { display: block; color: var(--dim); font-size: 13px; margin-bottom: 6px; }
      input { width: 100%; background: #15151a; color: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; font: inherit; }
      button { margin-top: 14px; width: 100%; font: inherit; color: var(--fg); background: #1f3a2a; border: 1px solid #2f6b45; border-radius: 8px; padding: 10px; cursor: pointer; }
      #msg { color: #ff7b72; min-height: 1.5em; font-size: 13px; margin: 10px 0 0; }
    </style>
  </body>
</html>
