---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0e" />
    <title>afterimage 殘影</title>
    <meta name="description" content="A personal wallpaper collection." />
  </head>
  <body>
    <header>
      <h1><img class="mark" src="/favicon.svg" alt="" width="24" height="24" />afterimage <span>殘影</span></h1>
      <div class="controls">
        <input id="q" type="search" placeholder="搜尋 caption…" autocomplete="off" />
        <div id="device" role="group" aria-label="裝置">
          <button data-v="all" aria-pressed="true">全部</button>
          <button data-v="desktop" aria-pressed="false">桌面</button>
          <button data-v="phone" aria-pressed="false">手機</button>
        </div>
        <select id="work" aria-label="作品"></select>
        <select id="emotion" aria-label="情緒"></select>
        <select id="rvfilter" aria-label="審核狀態" hidden></select>
        <span id="rvbar" hidden>
          <span id="rvprog"></span>
          <a href="/">離開審核</a>
        </span>
        <span id="count"></span>
        <span id="acct"></span>
      </div>
    </header>

    <main id="grid"></main>

    <footer class="tmdb">
      <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer"><img src="/tmdb-logo.svg" alt="TMDB" /></a>
      <p>This website uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.</p>
    </footer>

    <dialog id="lightbox">
      <button id="close" aria-label="關閉">×</button>
      <button id="prev" class="nav" aria-label="上一張" title="上一張 ←">‹</button>
      <button id="next" class="nav" aria-label="下一張" title="下一張 →">›</button>
      <div id="lb-main">
      <img id="lb-img" alt="" />
      <footer>
        <strong id="lb-cap"></strong>
        <span id="lb-meta"></span>
        <a id="lb-open" target="_blank" rel="noopener">原圖</a>
        <span id="lb-pal" aria-label="主要色彩"></span>
      </footer>
      <div id="lb-tags"></div>
      <div id="lb-out"></div>
      <section id="lb-rel">
        <div id="lb-tabs" role="tablist" aria-label="聯想方式"></div>
        <div id="lb-sim"></div>
      </section>
      <section id="lb-trail-wrap" hidden>
        <h2>思緒軌跡 <small>Backspace 回上一步</small></h2>
        <div id="lb-trail"></div>
      </section>
      <p id="lb-hint">← → 上一張 / 下一張 · 1–8 跳到聯想 · T 換聯想方式 · Esc 關閉</p>
      </div>
      <aside id="lb-review" hidden>
        <h2>審核 <span id="rv-status"></span></h2>
        <p id="rv-note"></p>
        <div class="rv-label">情緒 <small>按數字鍵</small></div>
        <div id="rv-emo"></div>
        <div class="rv-label">作品 <small>按 W 輸入</small></div>
        <div id="rv-works"></div>
        <input id="rv-input" list="rv-list" placeholder="輸入作品名稱,Enter 加入" autocomplete="off" />
        <datalist id="rv-list"></datalist>
        <div id="rv-new" hidden>
          <span>新作品「<b id="rv-new-title"></b>」類型</span>
          <select id="rv-kind">
            <option>game</option><option>anime</option><option>movie</option>
            <option>show</option><option>book</option><option>music</option>
          </select>
          <button id="rv-new-ok" type="button">建立並加入</button>
        </div>
        <div class="rv-actions">
          <button id="rv-confirm" type="button" class="primary">✓ 確認並下一張 <kbd>Enter</kbd></button>
          <button id="rv-skip" type="button">跳過 <kbd>N</kbd></button>
          <button id="rv-clear" type="button">清除作品 <kbd>X</kbd></button>
          <button id="rv-personal" type="button">個人照片 <kbd>M</kbd></button>
        </div>
      </aside>
      <div id="toast" hidden></div>
    </dialog>

    <script>
      (async () => {
      type Item = {
        id: string; caption: string; device: string; w: number; h: number; mb: number; src: string; raw: string;
        palette: string[]; similar: string[]; works: string[]; emotion: string; reviewed: boolean; personal: boolean; confidence: string; note: string;
        source: string; sourceUrl: string; artist: string; origin: string;
      };
      type WorkInfo = { id: string; title: string; kind: string; count: number; links?: Record<string, string> };
      const me: { admin: boolean } = await (await fetch('/api/me')).json();
      const { items, works }: { items: Item[]; works: WorkInfo[] } = await (await fetch('/api/catalog')).json();
      const byId = new Map(items.map((i) => [i.id, i]));
      const workTitle = new Map(works.map((w) => [w.id, w.title]));

      // Inside Out emotions and their colours
      const EMOTIONS: Record<string, { label: string; color: string }> = {
        joy: { label: '喜悅 Joy', color: '#f5c518' },
        sadness: { label: '憂傷 Sadness', color: '#3b82f6' },
        anger: { label: '憤怒 Anger', color: '#ef4444' },
        fear: { label: '恐懼 Fear', color: '#a855f7' },
        disgust: { label: '厭惡 Disgust', color: '#84cc16' },
        anxiety: { label: '焦慮 Anxiety', color: '#f97316' },
        envy: { label: '羨慕 Envy', color: '#14b8a6' },
        ennui: { label: '無聊 Ennui', color: '#6366f1' },
        embarrassment: { label: '尷尬 Embarrassment', color: '#ec4899' },
      };

      const grid = document.getElementById('grid')!;
      const q = document.getElementById('q') as HTMLInputElement;
      const count = document.getElementById('count')!;
      const box = document.getElementById('lightbox') as HTMLDialogElement;
      const workSel = document.getElementById('work') as HTMLSelectElement;
      const emoSel = document.getElementById('emotion') as HTMLSelectElement;
      let device = 'all';
      let visible: Item[] = items; // grid order after filtering; used by the arrow keys

      const opt = (value: string, text: string) => Object.assign(document.createElement('option'), { value, textContent: text });
      // Rebuilt after every review edit so the counts stay right.
      function buildWorkOptions() {
        const keep = workSel.value;
        const usage = new Map<string, number>();
        for (const it of items) for (const w of it.works) usage.set(w, (usage.get(w) ?? 0) + 1);
        const list = works
          .filter((w) => usage.has(w.id))
          .map((w) => ({ ...w, count: usage.get(w.id)! }))
          .sort((a, b) => b.count - a.count || a.title.localeCompare(b.title));
        const none = items.filter((i) => i.works.length === 0).length;
        workSel.replaceChildren(opt('', '全部作品'), opt('__none', `（未歸類）${none}`), ...list.map((w) => opt(w.id, `${w.title}  ${w.count}`)));
        workSel.value = [...workSel.options].some((o) => o.value === keep) ? keep : '';
        document.getElementById('rv-list')!.replaceChildren(
          ...works.map((w) => Object.assign(document.createElement('option'), { value: w.title, label: w.kind })),
        );
      }
      function buildEmotionOptions() {
        const keep = emoSel.value;
        const opts = [opt('', '全部情緒')];
        for (const [k, v] of Object.entries(EMOTIONS)) {
          const n = items.filter((i) => i.emotion === k).length;
          if (n) opts.push(opt(k, `${v.label}  ${n}`));
        }
        emoSel.replaceChildren(...opts);
        emoSel.value = [...emoSel.options].some((o) => o.value === keep) ? keep : '';
      }
      buildWorkOptions();
      buildEmotionOptions();

      const cards = items.map((it) => {
        const a = document.createElement('a');
        a.href = '#' + it.id;
        a.className = 'card ' + it.device;
        const ar = it.w / it.h;
        a.style.aspectRatio = `${it.w} / ${it.h}`;
        a.style.flex = `${ar * 100} 1 ${ar * 220}px`;
        const img = new Image();
        img.loading = 'lazy';
        img.alt = it.caption;
        img.src = `/thumbs/${it.id}.avif`;
        a.append(img);
        const dot = document.createElement('i');
        dot.className = 'dot';
        a.append(dot);
        a.addEventListener('click', (ev) => { ev.preventDefault(); go(it, 'fresh'); });
        grid.append(a);
        return { it, a, dot };
      });
      const cardOf = new Map(cards.map((c) => [c.it.id, c]));
      function paintCard(c: { it: Item; a: HTMLElement; dot: HTMLElement }) {
        const e = EMOTIONS[c.it.emotion];
        c.dot.hidden = !e;
        c.dot.style.background = e?.color ?? 'transparent';
        c.dot.title = e?.label ?? '';
        c.a.classList.toggle('reviewed', c.it.reviewed);
      }
      cards.forEach(paintCard);
      const hayOf = (it: Item) => [it.caption, ...it.works.map((w) => workTitle.get(w) ?? w)].join(' ').toLowerCase();

      function apply() {
        const term = q.value.trim().toLowerCase();
        const work = workSel.value;
        const emotion = emoSel.value;
        let n = 0;
        const rf = reviewOn ? rvSel.value : '';
        for (const { it, a } of cards) {
          const ok =
            (device === 'all' || it.device === device) &&
            (!term || hayOf(it).includes(term)) &&
            (!rf ||
              (rf === 'todo' && !it.reviewed) ||
              (rf === 'low' && !it.reviewed && it.confidence === 'l') ||
              (rf === 'mid' && !it.reviewed && it.confidence !== 'h') ||
              (rf === 'done' && it.reviewed)) &&
            (!work || (work === '__none' ? it.works.length === 0 : it.works.includes(work))) &&
            (!emotion || it.emotion === emotion);
          a.hidden = !ok;
          if (ok) n++;
        }
        count.textContent = `${n} / ${items.length}`;
        visible = cards.filter((c) => !c.a.hidden).map((c) => c.it);
      }

      // ---- Associations: different ways to wander from one memory to another ----
      type Mode = 'sim' | 'work' | 'emo' | 'color';
      const MODES: { key: Mode; label: string }[] = [
        { key: 'sim', label: '相似畫面' },
        { key: 'work', label: '同作品' },
        { key: 'emo', label: '同情緒・不同作品' },
        { key: 'color', label: '相近色調' },
      ];
      const LIMIT = 12;
      let mode: Mode = 'sim';
      let current: Item | null = null;
      let currentList: Item[] = [];
      let trail: Item[] = [];

      const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
      function colorDist(a: Item, b: Item): number {
        if (!a.palette.length || !b.palette.length) return Infinity;
        const W = [0.5, 0.3, 0.2];
        let d = 0;
        for (let i = 0; i < 3; i++) {
          const ca = rgb(a.palette[Math.min(i, a.palette.length - 1)]);
          const cb = rgb(b.palette[Math.min(i, b.palette.length - 1)]);
          d += W[i] * Math.hypot(ca[0] - cb[0], ca[1] - cb[1], ca[2] - cb[2]);
        }
        return d;
      }

      function relatedOf(it: Item, m: Mode): Item[] {
        switch (m) {
          case 'sim':
            return it.similar.map((id) => byId.get(id)).filter((x): x is Item => !!x);
          case 'work': {
            const mine = new Set(it.works);
            if (!mine.size) return [];
            const rank = (o: Item) => { const i = it.similar.indexOf(o.id); return i < 0 ? 99 : i; };
            return items
              .filter((o) => o.id !== it.id && o.works.some((w) => mine.has(w)))
              .sort((a, b) => rank(a) - rank(b) || colorDist(it, a) - colorDist(it, b))
              .slice(0, LIMIT);
          }
          case 'emo': {
            if (!it.emotion) return [];
            const mine = new Set(it.works);
            return items
              .filter((o) => o.id !== it.id && o.emotion === it.emotion && !o.works.some((w) => mine.has(w)))
              .sort((a, b) => colorDist(it, a) - colorDist(it, b))
              .slice(0, LIMIT);
          }
          case 'color':
            return items
              .filter((o) => o.id !== it.id)
              .sort((a, b) => colorDist(it, a) - colorDist(it, b))
              .slice(0, LIMIT);
        }
      }

      const thumb = (r: Item) => {
        const img = new Image();
        img.alt = r.caption;
        img.src = `/thumbs/${r.id}.avif`;
        return img;
      };

      // fresh: start a new wander (grid click, arrow keys). assoc: follow an association, remembered in the trail.
      function go(it: Item, via: 'fresh' | 'assoc') {
        if (via === 'assoc' && current) { trail.push(current); if (trail.length > 14) trail.shift(); }
        if (via === 'fresh') trail = [];
        current = it;
        show(it);
      }

      function back() {
        const prev = trail.pop();
        if (!prev) return;
        current = prev;
        show(prev);
      }

      function step(d: number) {
        if (!current) return;
        const list = visible.length ? visible : items;
        let i = list.findIndex((x) => x.id === current!.id);
        if (i < 0) i = d > 0 ? -1 : 0;
        go(list[(i + d + list.length) % list.length], 'fresh');
      }

      function show(it: Item) {
        (document.getElementById('lb-img') as HTMLImageElement).src = it.src;
        document.getElementById('lb-cap')!.textContent = it.caption;
        document.getElementById('lb-meta')!.textContent = `${it.w}×${it.h} · ${it.mb} MB`;
        (document.getElementById('lb-open') as HTMLAnchorElement).href = it.raw;
        history.replaceState(null, '', '#' + it.id);

        const pal = document.getElementById('lb-pal')!;
        pal.replaceChildren(...it.palette.map((c) => {
          const s = document.createElement('i');
          s.style.background = c;
          s.title = c;
          return s;
        }));

        const tags = document.getElementById('lb-tags')!;
        const chips: HTMLElement[] = it.works.map((id) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip work';
          b.textContent = workTitle.get(id) ?? id;
          b.title = '只看這部作品';
          b.addEventListener('click', () => { workSel.value = id; apply(); box.close(); });
          return b;
        });
        const emo = EMOTIONS[it.emotion];
        if (emo) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip emo';
          b.style.setProperty('--c', emo.color);
          b.textContent = emo.label;
          b.title = '只看這種情緒';
          b.addEventListener('click', () => { emoSel.value = it.emotion; apply(); box.close(); });
          chips.push(b);
        }
        if (it.personal) chips.push(Object.assign(document.createElement('span'), { className: 'chip', textContent: '個人照片' }));
        if (it.reviewed) {
          chips.push(Object.assign(document.createElement('span'), { className: 'chip', textContent: '已人工審核 ✓' }));
        } else if (it.works.length || emo) {
          chips.push(Object.assign(document.createElement('span'), { className: 'chip note', textContent: 'AI 建議・未審核', title: '作品與情緒由 AI 判斷,尚未人工確認' }));
        }
        tags.replaceChildren(...chips);

        // association tabs: keep the chosen mode if it has results, otherwise fall back
        const lists = new Map(MODES.map((m) => [m.key, relatedOf(it, m.key)] as const));
        if (!lists.get(mode)!.length) mode = MODES.find((m) => lists.get(m.key)!.length)?.key ?? 'sim';
        document.getElementById('lb-tabs')!.replaceChildren(...MODES.map((m) => {
          const n = lists.get(m.key)!.length;
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'tab';
          b.disabled = n === 0;
          b.setAttribute('role', 'tab');
          b.setAttribute('aria-selected', String(m.key === mode));
          b.textContent = `${m.label} ${n}`;
          b.addEventListener('click', () => { mode = m.key; show(it); });
          return b;
        }));

        currentList = lists.get(mode)!;
        const sim = document.getElementById('lb-sim')!;
        sim.replaceChildren(...currentList.map((r, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.title = r.caption;
          b.append(thumb(r));
          if (i < 8) b.append(Object.assign(document.createElement('span'), { className: 'n', textContent: String(i + 1) }));
          const e = EMOTIONS[r.emotion];
          if (e) b.style.setProperty('--c', e.color);
          b.addEventListener('click', () => go(r, 'assoc'));
          return b;
        }));
        sim.scrollLeft = 0;

        // trail of memories visited by following associations
        document.getElementById('lb-trail-wrap')!.hidden = trail.length === 0;
        document.getElementById('lb-trail')!.replaceChildren(...trail.map((r, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.title = r.caption;
          b.append(thumb(r));
          b.addEventListener('click', () => { trail = trail.slice(0, i); current = r; show(r); });
          return b;
        }));

        renderReview(it);
        renderOutbound(it);
        box.scrollTop = 0;
        if (!box.open) box.showModal();
      }

      function cycleMode() {
        if (!current) return;
        const order = MODES.map((m) => m.key);
        for (let k = 1; k <= order.length; k++) {
          const next = order[(order.indexOf(mode) + k) % order.length];
          if (relatedOf(current, next).length) { mode = next; show(current); return; }
        }
      }

      document.addEventListener('keydown', (ev) => {
        if (!box.open || ev.metaKey || ev.ctrlKey || ev.altKey) return;
        const tag = (ev.target as HTMLElement | null)?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return; // typing: leave keys alone
        const k = ev.key;
        if (reviewOn && reviewKey(ev)) { ev.preventDefault(); return; }
        if (k === 'ArrowLeft') step(-1);
        else if (k === 'ArrowRight') step(1);
        else if (!reviewOn && /^[1-8]$/.test(k)) { const r = currentList[Number(k) - 1]; if (r) go(r, 'assoc'); }
        else if (k === 't' || k === 'T') cycleMode();
        else if (k === 'Backspace') back();
        else return;
        ev.preventDefault();
      });
      document.getElementById('prev')!.addEventListener('click', () => step(-1));
      document.getElementById('next')!.addEventListener('click', () => step(1));


      // ---- Review mode (owner only): every edit is saved to the server as you make it ----
      const qs = new URLSearchParams(location.search);
      const reviewOn = me.admin && qs.get('review') === '1';
      if (qs.get('review') === '1' && !me.admin) location.replace('/login?next=' + encodeURIComponent('/?review=1'));

      const rvSel = document.getElementById('rvfilter') as HTMLSelectElement;
      const rvInput = document.getElementById('rv-input') as HTMLInputElement;
      const EMO_KEYS = Object.keys(EMOTIONS);
      const CONF: Record<string, string> = { h: '高', m: '中', l: '低' };
      let pendingTitle = '';

      function toast(msg: string) {
        const el = document.getElementById('toast')!;
        el.textContent = msg;
        el.hidden = false;
        setTimeout(() => { el.hidden = true; }, 2800);
      }

      async function api(path: string, method: string, body?: unknown) {
        const r = await fetch(path, { method, headers: { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
        if (r.status === 401) {
          toast('登入已過期,請重新登入');
          setTimeout(() => location.assign('/login?next=' + encodeURIComponent(location.pathname + location.search)), 800);
          throw new Error('unauthorized');
        }
        if (!r.ok) throw new Error(((await r.json().catch(() => ({}))) as { detail?: string }).detail ?? r.statusText);
        return r.json();
      }

      function progress() {
        document.getElementById('rvprog')!.textContent = `已審核 ${items.filter((i) => i.reviewed).length}/${items.length}`;
      }

      // The last state the server confirmed for each image, so a failed save can be undone on screen.
      type Snap = { works: string[]; emotion: string; personal: boolean; reviewed: boolean };
      const snap = (it: Item): Snap => ({ works: [...it.works], emotion: it.emotion, personal: it.personal, reviewed: it.reviewed });
      const saved = new Map<string, Snap>(items.map((i) => [i.id, snap(i)]));
      let saving: Promise<unknown> = Promise.resolve(); // saves run one after another so fast key presses stay in order

      function refresh(it: Item) {
        paintCard(cardOf.get(it.id)!);
        buildWorkOptions();
        buildEmotionOptions();
        progress();
        apply();
        show(it);
      }

      // Any edit counts as a review. The screen updates at once; the save follows.
      function touch(it: Item) {
        it.reviewed = true;
        refresh(it);
        const body = { works: [...it.works], emotion: it.emotion, personal: it.personal };
        saving = saving
          .then(() => api(`/api/images/${it.id}`, 'PATCH', body))
          .then(() => saved.set(it.id, snap(it)))
          .catch((e: Error) => {
            if (e.message === 'unauthorized') return;
            Object.assign(it, saved.get(it.id));
            refresh(it);
            toast(`儲存失敗,已還原:${e.message}`);
          });
      }

      function addWork(it: Item, id: string) {
        if (!it.works.includes(id)) it.works = [...it.works, id];
        touch(it);
      }

      function addWorkFromInput() {
        const v = rvInput.value.trim();
        if (!v || !current) return;
        const hit = works.find((w) => w.title.toLowerCase() === v.toLowerCase() || w.id === v.toLowerCase());
        if (hit) { rvInput.value = ''; rvInput.blur(); addWork(current, hit.id); return; }
        pendingTitle = v;
        document.getElementById('rv-new-title')!.textContent = v;
        document.getElementById('rv-new')!.hidden = false;
      }

      async function createWork() {
        if (!current || !pendingTitle) return;
        const it = current;
        const kind = (document.getElementById('rv-kind') as HTMLSelectElement).value;
        try {
          const w = await api('/api/works', 'POST', { title: pendingTitle, kind }) as { id: string; title: string; kind: string; created: boolean };
          if (!works.some((x) => x.id === w.id)) works.push({ id: w.id, title: w.title, kind: w.kind, count: 0 });
          workTitle.set(w.id, w.title);
          pendingTitle = '';
          rvInput.value = '';
          rvInput.blur();
          document.getElementById('rv-new')!.hidden = true;
          addWork(it, w.id);
        } catch (e) {
          if ((e as Error).message !== 'unauthorized') toast(`無法建立作品:${(e as Error).message}`);
        }
      }

      function nextUnreviewedFrom(list: Item[], idx: number) {
        for (let k = 1; k <= list.length; k++) {
          const c = list[(idx + k + list.length) % list.length];
          if (!c.reviewed) { go(c, 'fresh'); return; }
        }
        toast('這個範圍的圖都審核完了 ✓');
      }

      function skip() {
        if (!current) return;
        const list = visible.length ? visible : items;
        nextUnreviewedFrom(list, list.findIndex((x) => x.id === current!.id));
      }

      function confirmAndNext(it: Item) {
        const list = visible.length ? visible : items; // taken before the filter reacts to this edit
        const idx = list.findIndex((x) => x.id === it.id);
        touch(it);
        nextUnreviewedFrom(list, idx);
      }

      function reviewKey(ev: KeyboardEvent): boolean {
        if (!current) return false;
        const it = current;
        if (/^[1-9]$/.test(ev.key)) { it.emotion = EMO_KEYS[Number(ev.key) - 1]; touch(it); return true; }
        switch (ev.key.toLowerCase()) {
          case 'enter': confirmAndNext(it); return true;
          case 'n': skip(); return true;
          case 'x': it.works = []; touch(it); return true;
          case 'm': it.personal = !it.personal; touch(it); return true;
          case 'w': rvInput.focus(); return true;
        }
        return false;
      }

      function renderReview(it: Item) {
        const panel = document.getElementById('lb-review')!;
        panel.hidden = !reviewOn;
        if (!reviewOn) return;

        document.getElementById('rv-status')!.textContent = it.reviewed ? '已審核 ✓' : '未審核';
        const conf = it.confidence && !it.reviewed ? `AI 把握度「${CONF[it.confidence] ?? it.confidence}」` : '';
        document.getElementById('rv-note')!.textContent = [conf, !it.reviewed ? it.note : ''].filter(Boolean).join(' — ');

        document.getElementById('rv-emo')!.replaceChildren(...EMO_KEYS.map((k, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'rv-emo';
          b.style.setProperty('--c', EMOTIONS[k].color);
          b.setAttribute('aria-pressed', String(it.emotion === k));
          b.textContent = `${i + 1} ${EMOTIONS[k].label.split(' ')[0]}`;
          b.addEventListener('click', () => { it.emotion = k; touch(it); });
          return b;
        }));

        const list = document.getElementById('rv-works')!;
        list.replaceChildren(...it.works.map((id) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip work';
          b.textContent = `${workTitle.get(id) ?? id} ×`;
          b.title = '移除';
          b.addEventListener('click', () => { it.works = it.works.filter((w) => w !== id); touch(it); });
          return b;
        }));
        if (!it.works.length) list.append(Object.assign(document.createElement('span'), { className: 'chip', textContent: '（未歸類）' }));

        document.getElementById('rv-personal')!.setAttribute('aria-pressed', String(it.personal));
        document.getElementById('rv-new')!.hidden = !pendingTitle;
      }

      // ---- Looking further: links out to where more of this can be found ----
      const LINK_LABEL: Record<string, string> = { steam: 'Steam', anilist: 'AniList', tmdb: 'TMDB' };
      function renderOutbound(it: Item) {
        const links: [string, string][] = [];
        if (it.sourceUrl) links.push([`來源${it.artist ? '・' + it.artist : ''}`, it.sourceUrl]);
        if (!it.personal) {
          const u = encodeURIComponent(location.origin + it.raw);
          links.push(['以圖搜圖 SauceNAO', `https://saucenao.com/search.php?url=${u}`], ['Google Lens', `https://lens.google.com/uploadbyurl?url=${u}`], ['TinEye', `https://tineye.com/search?url=${u}`]);
        }
        for (const id of it.works.slice(0, 2)) {
          const w = works.find((x) => x.id === id);
          if (!w) continue;
          const q = encodeURIComponent(w.title);
          const tag = encodeURIComponent(w.title.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, ''));
          for (const [k, url] of Object.entries(w.links ?? {})) links.push([`${w.title} · ${LINK_LABEL[k] ?? k}`, url]);
          links.push([`Wallhaven「${w.title}」`, `https://wallhaven.cc/search?q=${q}&categories=110&purity=100&sorting=favorites`]);
          if (tag) links.push([`Danbooru`, `https://danbooru.donmai.us/posts?tags=${tag}`]);
          links.push(['Pixiv', `https://www.pixiv.net/tags/${q}/artworks`], ['Google 圖片', `https://www.google.com/search?tbm=isch&q=${q}+wallpaper`]);
        }
        const box = document.getElementById('lb-out')!;
        box.hidden = links.length === 0;
        box.replaceChildren(Object.assign(document.createElement('span'), { className: 'out-label', textContent: '往外找' }),
          ...links.map(([label, href]) => Object.assign(document.createElement('a'), { className: 'out', href, textContent: label, target: '_blank', rel: 'noopener noreferrer' })));
      }

      // wiring
      document.getElementById('rv-confirm')!.addEventListener('click', () => current && confirmAndNext(current));
      document.getElementById('rv-skip')!.addEventListener('click', skip);
      document.getElementById('rv-clear')!.addEventListener('click', () => { if (current) { current.works = []; touch(current); } });
      document.getElementById('rv-personal')!.addEventListener('click', () => { if (current) { current.personal = !current.personal; touch(current); } });
      document.getElementById('rv-new-ok')!.addEventListener('click', createWork);
      rvInput.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') { ev.preventDefault(); addWorkFromInput(); } });
      rvInput.addEventListener('change', addWorkFromInput);
      rvSel.addEventListener('change', apply);

      // account links
      const acct = document.getElementById('acct')!;
      if (me.admin) {
        acct.append(
          Object.assign(document.createElement('a'), { href: '/discover', textContent: '發掘' }),
          Object.assign(document.createElement('a'), { href: reviewOn ? '/' : '/?review=1', textContent: reviewOn ? '離開審核' : '審核' }),
          Object.assign(document.createElement('button'), { textContent: '登出', type: 'button', onclick: async () => { await api('/api/logout', 'POST'); location.reload(); } }),
        );
      } else {
        acct.append(Object.assign(document.createElement('a'), { href: '/login', textContent: '登入', className: 'dim' }));
      }

      if (reviewOn) {
        document.body.classList.add('review');
        rvSel.hidden = false;
        document.getElementById('rvbar')!.hidden = false;
        document.getElementById('lb-hint')!.textContent = '← → 上一張 / 下一張 · 點下方縮圖聯想 · T 換聯想方式 · Backspace 退回 · Esc 關閉';
        rvSel.replaceChildren(
          opt('', '全部審核狀態'), opt('todo', '未審核'), opt('mid', '未審核・把握度中以下'),
          opt('low', '未審核・把握度低'), opt('done', '已審核'),
        );
        progress();
      }

      q.addEventListener('input', apply);
      workSel.addEventListener('change', apply);
      emoSel.addEventListener('change', apply);
      document.querySelectorAll<HTMLButtonElement>('#device button').forEach((b) =>
        b.addEventListener('click', () => {
          device = b.dataset.v!;
          document.querySelectorAll('#device button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          apply();
        }),
      );
      document.getElementById('close')!.addEventListener('click', () => box.close());
      box.addEventListener('click', (ev) => { if (ev.target === box) box.close(); });
      box.addEventListener('close', () => history.replaceState(null, '', location.pathname));

      apply();
      const hit = items.find((i) => '#' + i.id === location.hash);
      if (hit) go(hit, 'fresh');
      })();
    </script>

    <style is:global>
      :root { color-scheme: dark; --bg: #0b0b0e; --fg: #e8e6e3; --dim: #8a8a93; --line: #23232a; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, "Noto Sans TC", sans-serif; }
      header { position: sticky; top: 0; z-index: 2; padding: 14px 20px; background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
      h1 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: .04em; }
      h1 .mark { width: 1.7em; height: 1.7em; vertical-align: -0.5em; margin: 0 6px 0 -4px; }
      h1 span { color: var(--dim); font-weight: 400; margin-left: 6px; }
      .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; flex: 1; }
      input[type=search] { background: #15151a; color: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 7px 12px; min-width: 220px; }
      #device { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
      #device button { background: none; color: var(--dim); border: 0; padding: 7px 14px; cursor: pointer; font: inherit; }
      #device button[aria-pressed=true] { background: #1d1d25; color: var(--fg); }
      #count { color: var(--dim); font-variant-numeric: tabular-nums; margin-left: auto; }
      #grid { display: flex; flex-wrap: wrap; gap: 10px; padding: 14px 20px 60px; }
      #grid::after { content: ""; flex: 10 1 0; }
      .card { display: block; background: #15151a; border-radius: 6px; overflow: hidden; }
      .card[hidden] { display: none; }
      .card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s, opacity .25s; }
      .card:hover img { transform: scale(1.03); }
      dialog { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; color: var(--fg); }
      dialog::backdrop { background: rgba(0,0,0,.88); }
      dialog { overflow-y: auto; }
      #lb-img { display: block; max-width: 96vw; max-height: calc(96vh - 320px); margin: 0 auto; border-radius: 4px; }
      dialog footer { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; justify-content: center; padding: 10px; }
      select { background: #15151a; color: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; max-width: 220px; font: inherit; }
      .card { position: relative; }
      .dot { position: absolute; top: 8px; right: 8px; width: 9px; height: 9px; border-radius: 50%; box-shadow: 0 0 0 2px #0008; }
      #lb-tags { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; padding: 0 10px 10px; }
      .chip { font: inherit; font-size: 12px; color: var(--dim); background: #15151a; border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; }
      button.chip { cursor: pointer; color: var(--fg); }
      button.chip:hover { border-color: var(--dim); }
      .chip.emo { border-color: var(--c); }
      .chip.note { font-style: italic; }
      #lb-pal { display: inline-flex; gap: 4px; }
      .nav { position: fixed; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 50%; border: 1px solid #ffffff22;
        background: #000a; color: var(--fg); font-size: 28px; line-height: 1; cursor: pointer; z-index: 3; padding: 0 0 4px; }
      .nav:hover { background: #000d; border-color: #ffffff55; }
      #prev { left: 14px; }
      #next { right: 14px; }
      #lb-rel { padding: 0 10px; }
      #lb-tabs { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; padding-bottom: 8px; }
      .tab { font: inherit; font-size: 12px; color: var(--dim); background: none; border: 1px solid var(--line); border-radius: 6px; padding: 4px 11px; cursor: pointer; }
      .tab[aria-selected=true] { color: var(--fg); background: #1d1d25; border-color: var(--dim); }
      .tab:disabled { opacity: .35; cursor: default; }
      #lb-sim button { position: relative; border-color: color-mix(in srgb, var(--c, #23232a) 55%, transparent); }
      #lb-sim .n { position: absolute; left: 0; top: 0; background: #000b; color: #ffeb3b; font-size: 11px; font-weight: 700; padding: 0 5px; border-radius: 0 0 4px 0; }
      #lb-trail-wrap { padding: 2px 10px 0; }
      #lb-trail-wrap h2 small { font-weight: 400; margin-left: 8px; opacity: .7; }
      #lb-trail { display: flex; gap: 6px; overflow-x: auto; }
      #lb-trail button { flex: none; height: 36px; padding: 0; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: #15151a; cursor: pointer; opacity: .75; }
      #lb-trail button:hover { opacity: 1; }
      #lb-trail img { height: 100%; width: auto; display: block; }
      [hidden] { display: none !important; }
      body.review .card.reviewed::after { content: '✓'; position: absolute; left: 8px; top: 5px; font-size: 13px; font-weight: 700; color: #7ee787; text-shadow: 0 0 4px #000; }
      #rvbar { display: inline-flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; font-size: 12px; color: var(--dim); }
      #rvbar button { font: inherit; font-size: 12px; color: var(--fg); background: #15151a; border: 1px solid var(--line); border-radius: 6px; padding: 4px 10px; cursor: pointer; }
      #rvbar a { color: var(--dim); }
      body.review dialog[open] { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 0 20px; width: min(1560px, 96vw); }
      body.review #lb-img { max-width: 100%; }
      body.review dialog[open] { padding-right: 62px; } /* keep clear of the fixed next button */
      #lb-main { min-width: 0; }
      #lb-review { padding: 16px 16px 16px 0; font-size: 13px; position: sticky; top: 0; align-self: start; max-height: 96vh; overflow-y: auto; }
      #lb-review h2 { margin: 0 0 4px; font-size: 14px; }
      #rv-status { color: var(--dim); font-weight: 400; margin-left: 6px; }
      #rv-note { min-height: 1.4em; margin: 0 0 10px; color: var(--dim); font-size: 12px; }
      .rv-label { margin: 12px 0 6px; color: var(--dim); font-size: 12px; }
      .rv-label small { opacity: .7; margin-left: 4px; }
      #rv-emo { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
      .rv-emo { font: inherit; font-size: 12px; color: var(--fg); background: #15151a; border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); border-radius: 6px; padding: 6px 4px; cursor: pointer; }
      .rv-emo:hover { border-color: var(--c); }
      .rv-emo[aria-pressed=true] { background: color-mix(in srgb, var(--c) 28%, #15151a); border-color: var(--c); font-weight: 600; }
      #rv-works { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
      #rv-input { width: 100%; background: #15151a; color: inherit; border: 1px solid var(--line); border-radius: 6px; padding: 7px 10px; font: inherit; }
      #rv-new { margin-top: 8px; padding: 8px; border: 1px dashed var(--line); border-radius: 6px; display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; font-size: 12px; }
      #rv-new select, #rv-new button { font: inherit; font-size: 12px; padding: 3px 8px; }
      .rv-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 16px; }
      .rv-actions button { font: inherit; font-size: 12px; color: var(--fg); background: #15151a; border: 1px solid var(--line); border-radius: 6px; padding: 8px 6px; cursor: pointer; }
      .rv-actions button:hover { border-color: var(--dim); }
      .rv-actions .primary { grid-column: 1 / -1; background: #1f3a2a; border-color: #2f6b45; font-size: 13px; padding: 10px; }
      .rv-actions button[aria-pressed=true] { background: #1d1d25; border-color: var(--fg); }
      kbd { font: inherit; font-size: 10px; opacity: .7; border: 1px solid #ffffff33; border-radius: 3px; padding: 0 4px; margin-left: 4px; }
      #toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); background: #000d; color: var(--fg); border: 1px solid var(--line); border-radius: 8px; padding: 9px 16px; z-index: 5; }
      footer.tmdb { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; justify-content: center; padding: 18px 20px 28px; color: var(--dim); font-size: 12px; }
      footer.tmdb img { height: 12px; width: auto; display: block; opacity: .85; }
      footer.tmdb p { margin: 0; }
      #acct { display: inline-flex; gap: 12px; align-items: center; font-size: 13px; }
      #acct a { color: var(--fg); text-decoration: none; opacity: .85; }
      #acct a.dim { color: var(--dim); }
      #acct a:hover { opacity: 1; text-decoration: underline; }
      #acct button { font: inherit; font-size: 13px; background: none; border: 0; color: var(--dim); cursor: pointer; padding: 0; }
      #lb-out { display: flex; flex-wrap: wrap; gap: 4px 10px; justify-content: center; align-items: baseline; padding: 0 12px 8px; font-size: 12px; }
      .out-label { color: var(--dim); }
      a.out { color: var(--dim); text-decoration: none; border-bottom: 1px dotted #ffffff33; }
      a.out:hover { color: var(--fg); border-bottom-color: var(--fg); }
      #lb-hint { text-align: center; color: var(--dim); font-size: 12px; margin: 4px 0 10px; }
      #lb-pal i { width: 18px; height: 18px; border-radius: 50%; border: 1px solid #ffffff33; }
            #lb-trail-wrap h2 { margin: 0 0 4px; font-size: 12px; font-weight: 500; color: var(--dim); text-align: center; letter-spacing: .08em; }
      #lb-sim { display: flex; gap: 8px; overflow-x: auto; }
      #lb-sim > :first-child, #lb-trail > :first-child { margin-left: auto; }
      #lb-sim > :last-child, #lb-trail > :last-child { margin-right: auto; }
      #lb-sim button { flex: none; height: 74px; padding: 0; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: #15151a; cursor: pointer; }
      #lb-sim button:hover { border-color: var(--dim); }
      #lb-sim img { height: 100%; width: auto; display: block; }
      dialog footer span { color: var(--dim); }
      dialog footer a { color: var(--fg); }
      #close { position: fixed; top: 10px; right: 16px; font-size: 28px; background: none; border: 0; color: var(--fg); cursor: pointer; }
    </style>
  </body>
</html>
